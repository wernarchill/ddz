<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============ 权限 ============ -->
    <!-- 局域网联机必需：TCP 对战连接 + UDP 房间广播发现 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 读取本机 WiFi 网段，用于显示「我的 IP」给其他玩家手动输入 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 出牌/炸弹震动反馈，可选 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 轮到出牌时的后台提醒（Android 13+ 需要运行时申请，拒绝也不影响对战） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 明确不需要：定位、相机、麦克风、通讯录、短信、电话状态、外部存储读写 -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.DDZ">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.DDZ">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
